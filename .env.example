# Copie para variáveis de ambiente da hospedagem. Não publique este arquivo com segredos reais.
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://seu-dominio.com
# Conta inicial de administrador: definida no primeiro início se ainda não houver admins.
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-mais-de-10-caracteres
ADMIN_NAME=Administrador principal
# Access Token de produção do Mercado Pago (nunca coloque no HTML/JavaScript do navegador).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_TOKEN_AQUI
# Segredo da assinatura de notificações/webhooks configurado no painel Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=COLOQUE_O_SEGREDO_DO_WEBHOOK_AQUI
